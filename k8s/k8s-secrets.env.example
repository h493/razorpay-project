# Copy to k8s-secrets.env (git-ignored) and fill in. Generate values with:
#   JWT_SECRET                      -> openssl rand -hex 32      (>= 32 chars, shared by gateway + merchant-service)
#   WEBHOOK_SECRET_ENCRYPTION_KEY   -> openssl rand -base64 32   (base64 of a 32-byte AES key)
#   VAULT_MASTER_KEY                -> openssl rand -base64 32   (base64 of a 32-byte AES key)
#   *_PASSWORD                      -> openssl rand -hex 16
JWT_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
VAULT_MASTER_KEY=

# Config repo read by config-service. It is public, so GIT_PASSWORD can stay empty;
# if you make it private, put a fine-grained GitHub PAT (Contents: read-only) there.
GIT_USERNAME=h493
GIT_CONFIG_REPO=https://github.com/h493/distributed-razorpay-config
GIT_PASSWORD=

POSTGRES_PASSWORD=
MERCHANT_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
OPERATIONS_DB_PASSWORD=
VAULT_DB_PASSWORD=

GRAFANA_ADMIN_PASSWORD=admin
